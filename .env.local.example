# ─────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT VARIABLES — copy this file to ".env.local" and fill in your key.
# This file is safe to commit to git; ".env.local" (with your real key) is NOT.
# ─────────────────────────────────────────────────────────────────────────────

# ── LIVEBLOCKS (needed for Milestone 1 — the shared canvas) ──────────────────
# Where to get it: https://liveblocks.io/dashboard  →  API Keys
#   1. Sign up free (no credit card needed)
#   2. On the API Keys page, copy the SECRET key for Development
#      (it starts with "sk_dev_...") and paste it below.
#
#   This key is used ONLY on the server (the auth endpoint in
#   app/api/liveblocks-auth/route.ts). Never put it in client code and never
#   prefix it with NEXT_PUBLIC_.
#
#   (The app uses its own auth endpoint, so no public key is needed.)

LIVEBLOCKS_SECRET_KEY=sk_paste_yours_here

# ── ANTHROPIC (needed later, Milestone 3 — the AI agent) ─────────────────────
# Where to get it: https://console.anthropic.com → API Keys → Create Key
#   (Requires billing enabled; costs a few cents per prototype run.)
# Leave commented out until Milestone 3.
#
# ANTHROPIC_API_KEY=sk-ant-paste_yours_here

# ── GOOGLE GEMINI (free alternative brain for the AI agent) ─────────────────
# Where to get it: https://aistudio.google.com → Get API key → Create API key
#   Free, no credit card. Daily limits apply. If this key is set, the agent
#   uses Gemini instead of Claude (set AGENT_PROVIDER=anthropic to force Claude).
#
# GEMINI_API_KEY=paste_yours_here

# ── SUPABASE (saved boards list: the /boards page) ──────────────────────────
# supabase.com → your Wireframe Studio project → Project Settings → API Keys.
# SUPABASE_URL: the "Project URL" (https://xxxx.supabase.co).
# SUPABASE_SECRET_KEY: a SECRET key (starts sb_secret_...). Server only:
# never add NEXT_PUBLIC_ to it.
SUPABASE_URL=https://paste_yours_here.supabase.co
SUPABASE_SECRET_KEY=sb_secret_paste_yours_here
# Sign-in (browser side): the same Project URL, plus the PUBLISHABLE key
# (sb_publishable_...). This one is meant to be public.
NEXT_PUBLIC_SUPABASE_URL=https://paste_yours_here.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste_yours_here

# ── MOCK AGENT (testing "Make it real" with no AI key) ──────────────────────
# Fixed sample designs instead of a real AI. Ignored in production.
#
# AGENT_PROVIDER=mock
